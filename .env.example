OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_ANSWER_MODEL=

# Databases (defaults shown)
DRAWING_DATABASE_PATH=data/engineering_drawings.db
SEARCH_DATABASE_PATH=data/drawing_search.db

# Optional embedding settings (experimental / future Hermes)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# Retrieval confidence thresholds (defaults)
RETRIEVAL_CONFIDENCE_HIGH_THRESHOLD=0.80
RETRIEVAL_CONFIDENCE_MEDIUM_THRESHOLD=0.50
RETRIEVAL_EXACT_IDENTIFIER_BOOST_WEIGHT=0.25

# Observability (default off)
RETRIEVAL_OBSERVABILITY_LOGGING=false
RETRIEVAL_LOG_LEVEL=INFO
